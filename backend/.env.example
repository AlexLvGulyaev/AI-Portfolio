# ============================================================
# AI Portfolio Backend - Configuration
# ============================================================
# Copy to .env and fill in required values.
# All values are required unless marked optional.
# ============================================================

# Environment
ENVIRONMENT=production

# Database (REQUIRED)
# PostgreSQL connection string
DATABASE_URL=postgresql://ai_portfolio:YOUR_PASSWORD@YOUR_DB_HOST:5432/ai_portfolio

# AI Providers — API keys only (REQUIRED / OPTIONAL)
# Runtime parameters (model, temperature, max_tokens, base_url) are managed
# in the admin console and stored in the ai_provider_settings table.
OPENAI_API_KEY=your_openai_api_key_here
GIGACHAT_AUTH_KEY=your_gigachat_auth_key_here

# Admin Console (REQUIRED)
ADMIN_API_TOKEN=your_secure_admin_api_token_here

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# Logging
LOG_LEVEL=WARNING

# CORS (REQUIRED)
# Comma-separated list of allowed origins
CORS_ORIGINS=https://ai.alex-n8n.site

# Debug (ALWAYS false in production)
DEBUG=false
