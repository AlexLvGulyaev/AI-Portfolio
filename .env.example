# ============================================================
# AI Portfolio - Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# .env is NOT committed to Git.
# ============================================================

# PostgreSQL Database
POSTGRES_USER=ai_portfolio
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=ai_portfolio

# Backend Database URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://ai_portfolio:your_secure_postgres_password_here@ai-portfolio-postgres:5432/ai_portfolio

# AI Providers (REQUIRED)
OPENAI_API_KEY=your_openai_api_key_here

# AI Providers (OPTIONAL - used as fallback)
GIGACHAT_AUTH_KEY=your_gigachat_auth_key_here

# CORS Origins (REQUIRED)
# Comma-separated list of allowed origins
CORS_ORIGINS=https://ai.alex-n8n.site

# Logging
LOG_LEVEL=WARNING

# Debug (ALWAYS false in production)
DEBUG=false
