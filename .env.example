# ============================================================
# AI Portfolio - Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# .env is NOT committed to Git.
# ============================================================

# PostgreSQL Database
POSTGRES_USER=ai_portfolio
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=ai_portfolio

# Backend Database URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://ai_portfolio:your_secure_postgres_password_here@ai-portfolio-postgres:5432/ai_portfolio

# AI Providers — API keys only (REQUIRED / OPTIONAL)
# Runtime parameters (model, temperature, max_tokens, base_url) are managed
# in the admin console and stored in the ai_provider_settings table.
OPENAI_API_KEY=your_openai_api_key_here
GIGACHAT_AUTH_KEY=your_gigachat_auth_key_here

# Admin Console (REQUIRED)
ADMIN_API_TOKEN=your_secure_admin_api_token_here

# CORS Origins (REQUIRED)
# Comma-separated list of allowed origins
CORS_ORIGINS=https://ai.alex-n8n.site

# KB registry owner (REQUIRED — compose fails hard without it).
# GitHub namespace whose public repositories are admissible as KB sources.
KB_REPO_OWNER=your_github_namespace_here

# GitHub token (OPTIONAL — increases GitHub API rate limits for KB sync)
GITHUB_TOKEN=

# Retrieval backend at first boot (OPTIONAL — chroma | weaviate; default chroma).
# Runtime switching is available in the admin console (Система → Retrieval).
# RAG_BACKEND=chroma

# Logging
LOG_LEVEL=WARNING

# Debug (ALWAYS false in production)
DEBUG=false
